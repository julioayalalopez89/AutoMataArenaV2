{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/julioayalalopez89/AutoMataArenaV2/docs/ai-program.schema.json",
  "title": "ECHO AI program (v0)",
  "type": "object",
  "required": ["format", "version", "name", "rules", "default"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "echo-ai" },
    "version": { "const": 0 },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "tick_ms": { "type": "integer", "minimum": 50, "maximum": 1000, "default": 100 },
    "rules": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/rule" }
    },
    "default": { "$ref": "#/$defs/step" }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["when", "do"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 60 },
        "when": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/condition" }
        },
        "do": { "$ref": "#/$defs/step" }
      }
    },
    "condition": {
      "type": "object",
      "required": ["sensor", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "sensor": {
          "enum": ["enemy_distance", "enemy_angle", "my_hp", "enemy_hp", "heat", "time_left"]
        },
        "op": { "enum": ["<", "<=", ">", ">=", "==", "!="] },
        "value": { "type": "number" }
      }
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "move_forward", "move_back", "turn_left", "turn_right",
            "punch_left", "punch_right", "kick", "special", "wait"
          ]
        },
        "duration_ms": { "type": "integer", "minimum": 50, "maximum": 3000 }
      }
    }
  }
}
