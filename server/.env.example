# Copia este archivo a .env y ajusta los valores. No subas .env al repo.

# Puerto del servidor (WebSocket y REST API comparten el mismo puerto)
PORT=9000

# Raspberry Pi de cada robot
ROBOT1_IP=192.168.1.100
ROBOT1_PORT=8080
ROBOT2_IP=192.168.1.101
ROBOT2_PORT=8080

# Combate
MATCH_DURATION=180
INITIAL_HP=100

# Daño por ataque
DMG_PUNCH_L=8
DMG_PUNCH_R=10
DMG_KICK=15
DMG_SPECIAL=25
